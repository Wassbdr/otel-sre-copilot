# LLM — any OpenAI-compatible endpoint. LLM_* wins; NIM_* is the fallback; default is NVIDIA NIM.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=fake          # scripted offline model (tests / CI), no key needed
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Observability backends (NodePort on localhost after `make up`)
PROMETHEUS_URL=http://localhost:9090
TEMPO_URL=http://localhost:3200
LOKI_URL=http://localhost:3100

# Kubernetes
KUBECONFIG=~/.kube/config
K8S_NAMESPACE=otel-demo

# Evaluation
CONTEXT_BUDGET_TOKENS=28000
MAX_TOOL_ITERATIONS=8
CHAOS_SEED=42
NUMPY_SEED=42
RANDOM_SEED=42
# LLM_TIMEOUT_S=180
# LLM_MAX_RETRIES=8   # free tiers rate-limit (HTTP 429); the client backs off and retries
